{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi Desktop",
  "version": "0.1.0",
  "identifier": "com.montaguegabe.multi-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multi Desktop",
        "width": 1024,
        "height": 728,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Git dashboard and commit tool for multi workspaces"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "multi"
        ]
      }
    }
  }
}
